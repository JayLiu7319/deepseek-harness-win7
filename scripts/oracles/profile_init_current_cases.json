  {
    "case": "existing-manifest",
    "kind": "profile-init-current",
    "operation": "init",
    "files": {
      "profiles/rescue/package.json": "{\"name\":\"old\",\"private\":true,\"dependencies\":{\"private\":\"1\"}}",
      "profiles/rescue/cordis.patch.yml": "- id: user\n  disabled: true\n"
    },
    "expected": {
      "outcome": {
        "error": "dsh: profile \"rescue\" already exists at $HOME/profiles/rescue/package.json; omit --from-default-profile to use it"
      },
      "exists": true,
      "beforePreserved": true,
      "files": [
        "cordis.patch.yml",
        "package.json"
      ],
      "manifest": {
        "name": "old",
        "private": true,
        "dependencies": {
          "private": "1"
        }
      }
    }
  },
