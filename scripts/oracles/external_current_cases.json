  {
    "case": "acp-current-parent-end_turn",
    "kind": "machine-current",
    "subagents": true,
    "actions": [
      {
        "method": "externalConfig",
        "env": {
          "PROBE_STOP": "end_turn"
        }
      },
      {
        "method": "externalRun",
        "prompt": [
          {
            "type": "text",
            "text": "explicit child task"
          }
        ]
      }
    ],
    "expected": {
      "results": [
        {
          "outcome": "value",
          "value": null
        },
        {
          "outcome": "error",
          "error": {
            "name": "AcpRunFailure",
            "message": "subagent-acp: Subagent failure (provider: ACP; stage: initialize; category: configuration)",
            "cause": {
              "name": "Error",
              "message": "subagent-acp: no working directory for the child — configure `cwd` or delegate from a parent session that has one"
            }
          }
        }
      ],
      "final": {
        "status": "idle",
        "events": [],
        "messages": [],
        "inbox": {
          "next-turn": [],
          "next-step": []
        }
      },
      "requests": [],
      "notifications": [
        {
          "name": "agent/created",
          "payload": {
            "agent": "machine"
          }
        },
        {
          "name": "agent/session-start",
          "payload": {
            "source": "startup",
            "agent": "machine"
          }
        },
        {
          "name": "agent/disposed",
          "payload": {
            "agent": "machine"
          }
        }
      ],
      "errors": []
    }
  },
